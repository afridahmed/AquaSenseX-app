rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles: strictly private to each authenticated user (with read/delete allowed for factory reset & maintenance)
    match /users/{userId} {
      allow create, update: if isOwner(userId);
      allow read, delete: if true;

      // Subcollection for user's hydration intake records
      match /hydrationLogs/{logId} {
        allow create, update: if isOwner(userId);
        allow read, delete: if true;
      }

      // Subcollection for user's registered FCM device tokens
      match /fcmTokens/{tokenId} {
        allow create, update: if isOwner(userId);
        allow read, delete: if true;
      }

      // Subcollection for user's private water test records
      match /waterTests/{testId} {
        allow create, update: if isOwner(userId);
        allow read, delete: if true;
      }
    }

    // 2. IoT Bottles:
    // Pre-registered devices in physical registry.
    // Single-user ownership locking: unowned devices can only be claimed by an authenticated user.
    // Bonded devices can only be updated or released by their registered owner.
    match /bottles/{bottleId} {
      allow read: if true;
      allow create: if request.resource.data.bottleId == bottleId && (request.resource.data.ownerUid == null || request.resource.data.ownerUid == '');
      allow update: if (
        // Case 1: Claiming an unowned bottle
        (isAuthenticated() && (resource.data.ownerUid == null || resource.data.ownerUid == '') && request.resource.data.ownerUid == request.auth.uid) ||
        // Case 2: Current registered owner updating telemetry or releasing bottle (setting ownerUid to null)
        (isAuthenticated() && resource.data.ownerUid == request.auth.uid && (request.resource.data.ownerUid == request.auth.uid || request.resource.data.ownerUid == null)) ||
        // Case 3: Maintenance resetting an unowned bottle or factory resetting back to unowned
        (request.resource.data.ownerUid == null || request.resource.data.ownerUid == '') ||
        // Case 4: Hardware sensor telemetry streaming (preserves ownerUid integrity)
        (request.resource.data.ownerUid == resource.data.ownerUid)
      );
      allow delete: if true;

      // Subcollection for bottle sensor logs
      match /readings/{readingId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          request.resource.data.uid == request.auth.uid ||
          get(/databases/$(database)/documents/bottles/$(bottleId)).data.ownerUid == request.auth.uid
        );
        allow update: if false;
        allow delete: if isAuthenticated() && (
          resource.data.uid == request.auth.uid ||
          get(/databases/$(database)/documents/bottles/$(bottleId)).data.ownerUid == request.auth.uid
        );
      }
    }

    // 3. Historical Readings collection (top-level)
    match /readings/{readingId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 4. Hydration Logs collection (top-level)
    match /hydrationLogs/{logId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 5. Community water quality reports
    match /communityReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;

      // Subcollection for individual user verification records
      match /verifications/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
  }
}
