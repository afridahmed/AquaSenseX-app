rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles: strictly private to each authenticated user
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subcollection for user's hydration intake records
      match /hydrationLogs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. IoT Bottles:
    // Production & dev bottles must already exist in registry. Arbitrary user creation is blocked.
    // Bottle claiming is atomic and secure: unowned bottles can only be claimed by setting ownerUid = request.auth.uid.
    // Owned bottles can only be updated or released by their registered owner.
    match /bottles/{bottleId} {
      allow read: if isAuthenticated();
      allow create: if false; // Users cannot create arbitrary production bottles
      allow update: if isAuthenticated() && (
        // Case 1: Claiming an unowned bottle
        ((resource.data.ownerUid == null || resource.data.ownerUid == '') && request.resource.data.ownerUid == request.auth.uid) ||
        // Case 2: Current registered owner updating telemetry or releasing bottle (setting ownerUid to null)
        (resource.data.ownerUid == request.auth.uid && (request.resource.data.ownerUid == request.auth.uid || request.resource.data.ownerUid == null))
      );
      allow delete: if false;

      // Subcollection for bottle sensor logs
      match /readings/{readingId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          request.resource.data.uid == request.auth.uid ||
          get(/databases/$(database)/documents/bottles/$(bottleId)).data.ownerUid == request.auth.uid
        );
        allow update: if false;
        allow delete: if isAuthenticated() && (
          resource.data.uid == request.auth.uid ||
          get(/databases/$(database)/documents/bottles/$(bottleId)).data.ownerUid == request.auth.uid
        );
      }
    }

    // 3. Historical Readings collection (top-level)
    match /readings/{readingId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 4. Hydration Logs collection (top-level)
    match /hydrationLogs/{logId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 5. Community water quality reports
    match /communityReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;

      // Subcollection for individual user verification records
      match /verifications/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
  }
}
