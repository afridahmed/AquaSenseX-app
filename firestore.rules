rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles: strictly private to each authenticated user
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subcollection for user's hydration intake records
      match /hydrationLogs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. IoT Bottles:
    // Authenticated users can check bottle presence and status.
    // Bottle ownership is strictly protected: an already owned bottle cannot be claimed or overwritten by a different user.
    match /bottles/{bottleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource == null ||
        !('ownerUid' in resource.data) ||
        resource.data.ownerUid == null ||
        resource.data.ownerUid == '' ||
        resource.data.ownerUid == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      // Subcollection for bottle sensor logs
      match /readings/{readingId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
      }
    }

    // 3. Historical Readings collection (top-level)
    match /readings/{readingId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 4. Hydration Logs collection (top-level)
    match /hydrationLogs/{logId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 5. Community water quality reports
    match /communityReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
  }
}
